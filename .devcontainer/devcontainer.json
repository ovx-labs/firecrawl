{
  "name": "Firecrawl Codespace",
  "image": "ghcr.io/ovx-labs/firecrawl-codespace-infra:latest",
  "workspaceFolder": "/workspaces/firecrawl/apps/api",
  "forwardPorts": [3000, 3002, 3004, 3005, 6379, 5432, 5672],
  "postCreateCommand": "bash /workspaces/firecrawl/.devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright",
        "rust-lang.rust-analyzer"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "node",
  "remoteEnv": {
    "PATH": "/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  }
}